{
  "build": {
    "appId": "xyz.xvoidsx.accela",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "blackice/**/*",
      "icons/**/*",
      "package.json",
      "settings-preload.js"
    ],
    "linux": {
      "category": "Network",
      "desktop": {
        "Categories": "Network;WebBrowser;",
        "Comment": "Fast, private web browser from xvoidsx",
        "Name": "Accela"
      },
      "icon": "icons/icon.png",
      "target": [
        "deb"
      ]
    },
    "productName": "Accela"
  },
  "author": {
    "name": "Raven Blackfeather",
    "email": "rav3nwing@proton.me"
  },
  "description": "Accela \u2014 xvoidsx's Electron-based web browser. Native blackice adblocking, Material You nightshadeNeon design.",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  },
  "license": "GPL-3.0-only",
  "main": "main.js",
  "name": "accela",
  "productName": "Accela",
  "scripts": {
    "build-deb": "electron-builder --linux deb",
    "start": "electron ."
  },
  "version": "0.14.0"
}